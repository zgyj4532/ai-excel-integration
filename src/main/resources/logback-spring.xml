<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 自定义日志级别颜色: ERROR=红, WARN=黄, INFO=蓝, DEBUG=白, TRACE=紫 -->
    <conversionRule conversionWord="clevel" converterClass="com.example.aiexcel.config.ColoredLevelConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %clevel(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- 默认配置（无profile时） -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
